<!--
  * Main changes from ROS1 to ROS2:
  *  - 'arg' tags in substitutions are replaced with 'var' tags (not in declarations).
  *  - nested includes now need be declared inside a group. 
  *  - 'type' attribute in node declaration is now 'exec'.
  *  - 'find' is replaced with 'find-pkg-share' in substitutions.
-->

<launch>

  <!-- Parameters -->

  <arg name="base_frame_id" default="base_footprint"/> <!-- Verified -->
  <arg name="odom_frame_id" default="odometry"/> <!-- Verified -->
  <arg name="odom_topic" default="/odom"/> <!-- Verified -->
  <arg name="map_frame_id" default="map"/> <!-- Verified -->
  <arg name="pose" default="-x 0.0 -y 0.0 -z 0.0 -Y 0.0"/> <!-- Verified -->
  <arg name="urdf_file" default="vizzy.urdf.xacro"/> <!-- Verified -->
  <arg name="paused" default="false"/> <!-- Verified -->
  <arg name="map_topic" default="/map"/> <!-- Verified -->
  <arg name="map_file" default="isr_7th_floor_simulation.yaml"/> <!-- Verified -->
  <arg name="obstacles_map_file" default="mapa_piso7_NOVO_AWESOME_obst.yaml"/> <!-- Verified -->
  <arg name="world" default="isr_7th_floor_world.sdf"/>
  <arg name="world_pkg" default="$(find-pkg-share vizzy_gazebo)"/>
  <arg name="map_yaml" default="$(find-pkg-share vizzy_navigation)/maps/$(var map_file)" description="Path to the map YAML file"/> <!-- Verified -->
  <arg name="obstacles_map_yaml" default="$(find-pkg-share vizzy_navigation)/maps/$(var obstacles_map_file)" description="Path to the obstacles map YAML file"/> <!-- Verified -->
  <arg name="use_obstacles" default="false"/> <!-- Verified -->
  <arg name="log_level" default="info"/> <!-- Verified -->
  <arg name="scan_topic_front" default="/nav_hokuyo_laser/front/scan" description="The name of the output scan topic"/> <!-- Verified -->
  <arg name="scan_topic_rear" default="/nav_hokuyo_laser/rear/scan" description="The name of the rear output scan topic"/> <!-- Verified -->
  <arg name="params_file" default="$(find-pkg-share vizzy_navigation)/config/nav2_configuration.yaml" description="Path to the Nav2 parameters file"/> <!-- Verified -->

  <!-- Launch gazebo -->
  <include file="$(find-pkg-share vizzy_gazebo)/launch/gazebo_launch.xml">
    <arg name="pose" value="$(var pose)"/>
    <arg name="urdf_file" value="$(var urdf_file)"/>
    <arg name="paused" value="$(var paused)"/>
    <arg name="use_sim_time" value="True"/>
    <arg name="world" value="$(var world)"/>
    <arg name="world_pkg" value="$(var world_pkg)"/>
    <arg name="base_frame_id" value="$(var base_frame_id)"/>
    <arg name="odom_frame_id" value="$(var odom_frame_id)"/>
    <arg name="odom_topic" value="$(var odom_topic)"/>
    <arg name="scan_front_topic" value="$(var scan_topic_front)"/>
    <arg name="scan_rear_topic" value="$(var scan_topic_rear)"/>
  </include>

  <!-- Launch navigation stack -->
  <group if="$(var use_obstacles)">
    <include file="$(find-pkg-share vizzy_navigation)/launch/navigation_launch.py">
      <arg name="use_sim_time" value="True"/>
      <arg name="params_file" value="$(var params_file)"/>
      <arg name="autostart" value="true"/>
      <arg name="use_respawn" value="false"/>
      <arg name="log_level" value="$(var log_level)"/>
      <arg name="map_topic" value="$(var map_topic)"/>
      <arg name="scan_topic_front" value="$(var scan_topic_front)"/>
      <arg name="scan_topic_rear" value="$(var scan_topic_rear)"/>
      <arg name="map_yaml" value="$(var obstacles_map_yaml)"/>
      <arg name="base_frame_id" value="$(var base_frame_id)"/>
      <arg name="odom_frame_id" value="$(var odom_frame_id)"/>
      <arg name="map_frame_id" value="$(var map_frame_id)"/>
    </include>
  </group>
  <group unless="$(var use_obstacles)">
    <include file="$(find-pkg-share vizzy_navigation)/launch/navigation_launch.py">
      <arg name="use_sim_time" value="True"/>
      <arg name="params_file" value="$(var params_file)"/>
      <arg name="autostart" value="true"/>
      <arg name="use_respawn" value="false"/>
      <arg name="log_level" value="$(var log_level)"/>
      <arg name="map_topic" value="$(var map_topic)"/>
      <arg name="scan_topic_front" value="$(var scan_topic_front)"/>
      <arg name="scan_topic_rear" value="$(var scan_topic_rear)"/>
      <arg name="map_yaml" value="$(var map_yaml)"/>
      <arg name="base_frame_id" value="$(var base_frame_id)"/>
      <arg name="odom_frame_id" value="$(var odom_frame_id)"/>
      <arg name="map_frame_id" value="$(var map_frame_id)"/>
    </include>
  </group>

  <!-- Start RViz2 using the new python launcher from vizzy_launch -->
  <include file="$(find-pkg-share vizzy_launch)/launch/rviz_launch.py">
  </include>
  
</launch>
