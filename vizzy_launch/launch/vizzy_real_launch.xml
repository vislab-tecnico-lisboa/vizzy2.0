<!--
  * Main changes from ROS1 to ROS2:
  *  - 'arg' tags in substitutions are replaced with 'var' tags (not in declarations).
  *  - 'type' attribute in node declaration is now 'exec'.
  *  - 'find' is replaced with 'find-pkg-share' in substitutions.
-->

<launch>
  <arg name="map_file" default="isr_7th_floor_simulation.yaml" />
  <arg name="obstacles_map_file" default="mapa_piso7_NOVO_AWESOME_obst.yaml" />
  <arg name="use_obstacles" default="true" />
  <arg name="use_navigation" default="true" description="Whether to use the navigation stack"/>
  <arg name="use_laser_filters" default="true" description="Whether to use laser filters for the front and rear lasers"/>
  <arg name="node_name_front" default="nav_hokuyo_node" description="Name for the urg_node instance"/>
  <arg name="node_name_rear" default="nav_hokuyo_rear_node" description="Name for the rear urg_node instance"/>
  <arg name="scan_topic_front" default="/nav_hokuyo_laser/front/scan" description="The name of the output scan topic"/>
  <arg name="scan_topic_rear" default="/nav_hokuyo_laser/rear/scan" description="The name of the rear output scan topic"/>
  <arg name="scan_topic_filtered_front" default="/scan_filtered_front" description="The name of the filtered front scan topic"/>
  <arg name="scan_topic_filtered_rear" default="/scan_filtered_rear" description="The name of the filtered rear scan topic"/>
  <arg name="scan_topic_merged" default="/scan_merged" description="Merged front+rear scan topic fed to AMCL for localization"/>
  <arg name="serial_port_front" default="/dev/ttyACM1" description="Serial port for the front laser scanner"/>
  <arg name="serial_port_rear" default="/dev/ttyACM0" description="Serial port for the rear laser scanner"/>
  <arg name="front_laser_frame" default="nav_hokuyo_laser_link" description="Frame id for front laser link."/>
  <arg name="rear_laser_frame" default="nav_hokuyo_rear_laser_link" description="Frame id for rear laser link."/>
  <arg name="urdf_file" default="vizzy.urdf.xacro" description="URDF file for the robot"/>
  <arg name="odom_frame_id" default="odometry" description="Frame id for the odometry"/>
  <arg name="base_frame_id" default="base_footprint" description="Frame id for the base footprint"/>
  <arg name="params_file" default="$(find-pkg-share vizzy_navigation)/config/nav2_configuration.yaml" description="Path to the Nav2 parameters file"/>
  <arg name="autostart" default="true" description="Whether to autostart the navigation stack"/>
  <arg name="use_respawn" default="false" description="Whether to respawn the navigation nodes if they crash"/>
  <arg name="log_level" default="info" description="Log level for the navigation stack"/>
  <arg name="map_topic" default="/map" description="Topic for the map data"/>
  <arg name="map_yaml" default="$(find-pkg-share vizzy_navigation)/maps/$(var map_file)" description="Path to the map YAML file"/>
  <arg name="obstacles_map_yaml" default="$(find-pkg-share vizzy_navigation)/maps/$(var obstacles_map_file)" description="Path to the obstacles map YAML file"/>
  <arg name="laser_filter_params_file" default="$(find-pkg-share vizzy_sensors)/config/hokuyo_filters.yaml" description="Path to the laser filters parameters file"/>
  <arg name="map_frame_id" default="map" description="Frame id for the map"/>
  <arg name="update_min_d" default="0.05" description="Minimum distance for localization updates"/>
  <arg name="update_min_a" default="0.05" description="Minimum angle for localization updates"/>
  <arg name="laser_max_range" default="-1.0" description="Maximum range for the laser scanner"/>
  <arg name="beam_skip_distance" default="5.0" description="Distance threshold for beam skipping"/>
  <arg name="beam_skip_error_threshold" default="0.5" description="Error threshold for beam skipping"/>
  <arg name="beam_skip_threshold" default="0.5" description="Threshold for beam skipping"/>
  <arg name="do_beamskip" default="true" description="Enable or disable beam skipping in the laser scanner"/>
  <arg name="linear_odom_scale" default="1.0" description="Scale factor for linear odometry"/>
  <arg name="angular_odom_scale" default="1.0" description="Scale factor for angular odometry"/>
  <arg name="controller_frequency" default="20.0" description="Frequency of the controller in Hz"/>
  <arg name="path_align_forward_point_distance" default="0.325" description="Forward point distance for PathAlign"/>
  <arg name="goal_align_forward_point_distance" default="0.325" description="Forward point distance for GoalAlign"/>
  <arg name="inflation_radius" default="1.0" description="Inflation radius for the costmap"/>
  <arg name="path_align_scale" default="32.0" description="Scale for PathAlign"/>
  <arg name="goal_align_scale" default="24.0" description="Scale for GoalAlign"/>
  <arg name="path_dist_scale" default="32.0" description="Scale for PathDist"/>
  <arg name="goal_dist_scale" default="24.0" description="Scale for GoalDist"/>
  <arg name="cost_scaling_factor" default="3.0" description="Cost scaling factor for the inflation layer in the costmap"/>
  <arg name="base_obstacle_scale" default="0.02" description="Base obstacle scale for the costmap. This is used by the local and global costmaps to scale the cost of obstacles."/>
  <arg name="controller_plugin_type" default="MPPI" description="Type of controller plugin to use. Options: DWB, RPP, MPPI"/>
  <arg name="expected_planner_frequency" default="0.2" description="Expected frequency of the planner in Hz"/>
  <arg name="planner_plugin_type" default="ThetaStar" description="Planner plugin to use for the navigation stack"/>
  <arg name="robot_radius" default="0.45" description="Robot radius for the navigation stack. This is used by the local and global costmaps to scale the cost of obstacles."/>
  <arg name="mppi_wide_cost_critic_cost_weight" default="3.82" description="Cost weight for the wide MPPI cost critic"/>
  <arg name="mppi_narrow_cost_critic_cost_weight" default="10.0" description="Cost weight for the narrow MPPI cost critic"/>
  <arg name="mppi_wide_path_align_critic_cost_weight" default="14.0" description="Cost weight for the wide MPPI path align critic"/>
  <arg name="mppi_narrow_path_align_critic_cost_weight" default="32.0" description="Cost weight for the narrow MPPI path align critic"/>
  <arg name="mppi_obstacles_critic_repulsion_weight" default="1.5" description="Repulsion weight for the MPPI obstacles critic"/>
  <arg name="mppi_obstacles_critic_critical_weight" default="20.0" description="Critical weight for the MPPI obstacles critic"/>
  <arg name="mppi_obstacles_critic_collision_margin_distance" default="0.2" description="Collision margin distance for the MPPI obstacles critic"/>
  <arg name="mppi_wide_wz_std" default="0.2" description="Standard deviation for the wide MPPI controller"/>
  <arg name="mppi_narrow_wz_std" default="0.13" description="Standard deviation for the narrow MPPI controller"/>
  <arg name="velocity_smoother_feedback_type" default="OPEN_LOOP" description="Feedback type for the velocity smoother. Options: CLOSED_LOOP, OPEN_LOOP"/>
  <arg name="dock_pose_stl_model_path" default="$(find-pkg-share vizzy_navigation)/models/docking_pattern.stl" description="Path to the STL model for the dock pose estimation"/>
  <arg name="battery_state" default="0" description="Initial battery state. 0: Not charging, 1: Charging"/>
  <arg name="use_battery_state_simulation" default="false" description="Whether to use the battery state simulation node or the real battery state."/>
  <arg name="publish_dock_point_cloud" default="false" description="Whether to publish the dock point cloud for visualization."/>
  <arg name="docking_bt_selection" default="0" description="Short integer flag to indicate the BT to use for the docking procedure. If set to 0, the docking procedure with staging pose navigation is activated, if set to 1, the docking procedure without staging pose navigation is activated, if set to 2, the estimator-only docking procedure is activated."/>
  <arg name="force_centroid_guess" default="false" description="Whether to force the centroid guess in the docking procedure."/>
  <arg name="use_statistical_outlier_removal_and_downsampling" default="true" description="Whether to use statistical outlier removal and downsampling in the dock pose estimator."/>

  <!-- General MPPI Controller Parameters -->
  <arg name="mppi_cost_critic_cost_weight" default="1.5" description="Cost weight for the general MPPI cost critic"/>
  <arg name="mppi_path_align_critic_cost_weight" default="10.0" description="Cost weight for the general MPPI path align critic"/>
  <arg name="mppi_time_steps" default="64" description="Number of time steps (points) in candidate trajectories."/>
  <arg name="mppi_batch_size" default="2000" description="Count of randomly sampled candidate trajectories from current optimal control sequence in a given iteration."/>
  <arg name="mppi_vx_std" default="0.3" description="Standard deviation for linear velocity in the MPPI controller."/>
  <arg name="mppi_wz_std" default="0.2" description="Standard deviation for the general MPPI controller"/>
  <arg name="mppi_vx_max" default="0.4" description="Maximum linear velocity in the MPPI controller."/>
  <arg name="mppi_temperature" default="0.3" description="Selectiveness of trajectories by their costs."/>
  <arg name="mppi_iteration_count" default="1" description="Iteration count in the MPPI algorithm. Recommended to remain as 1 and instead prefer larger batch sizes."/>
  <arg name="mppi_constraint_critic_cost_weight" default="4.0" description="Cost weight for the MPPI constraint critic."/>

  <arg name="always_send_full_costmap" default="false" description="Whether to always send the full costmap to the controller."/>
  <arg name="transform_tolerance" default="0.1" description="Transform tolerance for the navigation stack."/>

  <arg name="use_patrol" default="false" description="Launch the autonomous patrol node."/>
  <arg name="patrol_waypoints_file" default="$(find-pkg-share vizzy_navigation)/config/patrol_waypoints_real.yaml" description="Path to the patrol waypoints YAML file."/>

  <!-- Both lasers have the same angle_min and angle_max specifications. -->
  <arg name="angle_min" default="-1.309" description="Minimum angle for the laser scanner."/>
  <arg name="angle_max" default="1.309" description="Maximum angle for the laser scanner."/>

  <arg name="linear_vel_scale" default="false" description="Apply scale factor for linear velocity commands."/>
  <arg name="angular_vel_scale" default="false" description="Apply scale factor for angular velocity commands."/>

  <arg name="log_level_segway" default="info" description="Log level for segway_rmp_ros2."/>

  <arg name="inter_cycle_delay" default="0.0" description="Idle gap between query cycles (seconds) for kokam battery service."/>

  <arg name="staging_pose_simulation" default="-x -1.0 -y 0.0 -Y 0.0" description="Simulated dock pose in the format 'x y Yaw' for testing the docking procedure in simulation."/>
  <arg name="staging_pose_real" default="-x -5.132 -y -5.142 -Y -0.111" description="Real dock pose in the format 'x y Yaw' for the docking procedure with the real robot."/>

  <!-- Launch the laser filters -->
  <group if="$(var use_laser_filters)">
    <include file="$(find-pkg-share vizzy_sensors)/launch/hokuyo/hokuyo-filters_launch.xml">
      <arg name="scan_topic_front" value="$(var scan_topic_front)" />
      <arg name="scan_topic_filtered_front" value="$(var scan_topic_filtered_front)" />
    </include>

    <include file="$(find-pkg-share vizzy_robot)/launch/real_robot_launch.xml">
      <arg name="urdf_file" value="$(var urdf_file)" />
      <arg name="odom_frame_id" value="$(var odom_frame_id)" />
      <arg name="base_frame_id" value="$(var base_frame_id)" />
      <arg name="node_name_front" value="$(var node_name_front)" />
      <arg name="node_name_rear" value="$(var node_name_rear)" />
      <arg name="scan_topic_front" value="$(var scan_topic_filtered_front)" />
      <arg name="scan_topic_rear" value="$(var scan_topic_filtered_rear)" />
      <arg name="serial_port_front" value="$(var serial_port_front)" />
      <arg name="serial_port_rear" value="$(var serial_port_rear)" />
      <arg name="front_laser_frame" value="$(var front_laser_frame)" />
      <arg name="rear_laser_frame" value="$(var rear_laser_frame)" />
      <arg name="angle_min" value="$(var angle_min)" />
      <arg name="angle_max" value="$(var angle_max)" />
      <arg name="linear_odom_scale" value="$(var linear_odom_scale)" />
      <arg name="angular_odom_scale" value="$(var angular_odom_scale)" />
      <arg name="linear_vel_scale" value="$(var linear_vel_scale)" />
      <arg name="angular_vel_scale" value="$(var angular_vel_scale)" />
      <arg name="log_level_segway" value="$(var log_level_segway)" />
    </include>

    <!-- Merge the filtered front + rear scans into one ~300 deg scan for AMCL.
         Each scan is transformed (via TF) into the base frame, concatenated, and
         re-projected to a single LaserScan, giving the particle filter coverage
         behind the robot so along-corridor position is observable (front-only is
         aliased). -->
    <node pkg="dual_laser_merger" exec="dual_laser_merger_node" name="dual_laser_merger" output="screen">
      <param name="laser_1_topic" value="$(var scan_topic_filtered_front)" />
      <param name="laser_2_topic" value="$(var scan_topic_filtered_rear)" />
      <param name="merged_scan_topic" value="$(var scan_topic_merged)" />
      <param name="target_frame" value="$(var base_frame_id)" />
      <!-- Positioning comes from the URDF TF, no extra manual offsets. -->
      <param name="laser_1_x_offset" value="0.0" />
      <param name="laser_1_y_offset" value="0.0" />
      <param name="laser_1_yaw_offset" value="0.0" />
      <param name="laser_2_x_offset" value="0.0" />
      <param name="laser_2_y_offset" value="0.0" />
      <param name="laser_2_yaw_offset" value="0.0" />
      <!-- The two Hokuyos are not hardware-synced, thus we widen the time tolerance so
           message_filters actually pairs their scans (too tight => no output). -->
      <param name="tolerance" value="0.05" />
      <param name="queue_size" value="5" />
      <param name="angle_min" value="-3.141592653589793" />
      <param name="angle_max" value="3.141592653589793" />
      <param name="angle_increment" value="0.005800" />
      <param name="scan_time" value="0.0333333" />
      <param name="range_min" value="0.04" />
      <param name="range_max" value="30.0" />
      <param name="min_height" value="-5.0" />
      <param name="max_height" value="5.0" />
      <param name="use_inf" value="true" />
      <param name="inf_epsilon" value="1.0" />
      <param name="allowed_radius" value="0.45" />
      <param name="enable_shadow_filter" value="true" />
      <param name="enable_average_filter" value="true" />
    </node>


    <group if="$(var use_navigation)">
      <group if="$(var use_obstacles)">
        <include file="$(find-pkg-share vizzy_navigation)/launch/navigation_launch.py">
          <arg name="use_sim_time" value="false"/>
          <arg name="params_file" value="$(var params_file)"/>
          <arg name="autostart" value="$(var autostart)"/>
          <arg name="use_respawn" value="$(var use_respawn)"/>
          <arg name="log_level" value="$(var log_level)"/>
          <arg name="map_topic" value="$(var map_topic)"/>
          <arg name="scan_topic_front" value="$(var scan_topic_filtered_front)"/>
          <arg name="scan_topic_rear" value="$(var scan_topic_filtered_rear)"/>
          <arg name="scan_topic_amcl" value="$(var scan_topic_merged)"/>
          <arg name="map_yaml" value="$(var obstacles_map_yaml)"/>
          <arg name="base_frame_id" value="$(var base_frame_id)"/>
          <arg name="odom_frame_id" value="$(var odom_frame_id)"/>
          <arg name="map_frame_id" value="$(var map_frame_id)"/>
          <arg name="update_min_d" value="$(var update_min_d)"/>
          <arg name="update_min_a" value="$(var update_min_a)"/>
          <arg name="laser_max_range" value="$(var laser_max_range)"/>
          <arg name="beam_skip_distance" value="$(var beam_skip_distance)"/>
          <arg name="beam_skip_error_threshold" value="$(var beam_skip_error_threshold)"/>
          <arg name="beam_skip_threshold" value="$(var beam_skip_threshold)"/>
          <arg name="do_beamskip" value="$(var do_beamskip)"/>
          <arg name="controller_frequency" value="$(var controller_frequency)"/>
          <arg name="path_align_forward_point_distance" value="$(var path_align_forward_point_distance)"/>
          <arg name="goal_align_forward_point_distance" value="$(var goal_align_forward_point_distance)"/>
          <arg name="inflation_radius" value="$(var inflation_radius)"/>
          <arg name="path_align_scale" value="$(var path_align_scale)"/>
          <arg name="goal_align_scale" value="$(var goal_align_scale)"/>
          <arg name="path_dist_scale" value="$(var path_dist_scale)"/>
          <arg name="goal_dist_scale" value="$(var goal_dist_scale)"/>
          <arg name="cost_scaling_factor" value="$(var cost_scaling_factor)"/>
          <arg name="base_obstacle_scale" value="$(var base_obstacle_scale)"/>
          <arg name="controller_plugin_type" value="$(var controller_plugin_type)"/>
          <arg name="expected_planner_frequency" value="$(var expected_planner_frequency)"/>
          <arg name="planner_plugin_type" value="$(var planner_plugin_type)"/>
          <arg name="robot_radius" value="$(var robot_radius)"/>
          <arg name="mppi_wide_ cost_critic_cost_weight" value="$(var mppi_wide_cost_critic_cost_weight)"/>
          <arg name="mppi_narrow_cost_critic_cost_weight" value="$(var mppi_narrow_cost_critic_cost_weight)"/>
          <arg name="mppi_wide_path_align_critic_cost_weight" value="$(var mppi_wide_path_align_critic_cost_weight)"/>
          <arg name="mppi_narrow_path_align_critic_cost_weight" value="$(var mppi_narrow_path_align_critic_cost_weight)"/>
          <arg name="mppi_obstacles_critic_repulsion_weight" value="$(var mppi_obstacles_critic_repulsion_weight)"/>
          <arg name="mppi_obstacles_critic_critical_weight" value="$(var mppi_obstacles_critic_critical_weight)"/>
          <arg name="mppi_obstacles_critic_collision_margin_distance" value="$(var mppi_obstacles_critic_collision_margin_distance)"/>
          <arg name="mppi_wide_wz_std" value="$(var mppi_wide_wz_std)"/>
          <arg name="mppi_narrow_wz_std" value="$(var mppi_narrow_wz_std)"/>
          <arg name="velocity_smoother_feedback_type" value="$(var velocity_smoother_feedback_type)"/>
          <arg name="dock_pose_stl_model_path" value="$(var dock_pose_stl_model_path)"/>
          <arg name="use_battery_state_simulation" value="$(var use_battery_state_simulation)"/>
          <arg name="publish_dock_point_cloud" value="$(var publish_dock_point_cloud)"/>
          <arg name="docking_bt_selection" value="$(var docking_bt_selection)"/>
          <arg name="force_centroid_guess" value="$(var force_centroid_guess)"/>
          <arg name="use_statistical_outlier_removal_and_downsampling" value="$(var use_statistical_outlier_removal_and_downsampling)"/>
          <arg name="mppi_cost_critic_cost_weight" value="$(var mppi_cost_critic_cost_weight)"/>
          <arg name="mppi_path_align_critic_cost_weight" value="$(var mppi_path_align_critic_cost_weight)"/>
          <arg name="mppi_time_steps" value="$(var mppi_time_steps)"/>
          <arg name="mppi_batch_size" value="$(var mppi_batch_size)"/>
          <arg name="mppi_vx_std" value="$(var mppi_vx_std)"/>
          <arg name="mppi_wz_std" value="$(var mppi_wz_std)"/>
          <arg name="mppi_vx_max" value="$(var mppi_vx_max)"/>
          <arg name="mppi_temperature" value="$(var mppi_temperature)"/>
          <arg name="mppi_iteration_count" value="$(var mppi_iteration_count)"/>
          <arg name="mppi_constraint_critic_cost_weight" value="$(var mppi_constraint_critic_cost_weight)"/>
          <arg name="always_send_full_costmap" value="$(var always_send_full_costmap)"/>
          <arg name="transform_tolerance" value="$(var transform_tolerance)"/>
          <arg name="use_patrol" value="$(var use_patrol)"/>
          <arg name="waypoints_file" value="$(var patrol_waypoints_file)"/>
          <arg name="staging_pose_simulation" value="$(var staging_pose_simulation)"/>
          <arg name="staging_pose_real" value="$(var staging_pose_real)"/>
        </include>
      </group>
      <group unless="$(var use_obstacles)">
        <include file="$(find-pkg-share vizzy_navigation)/launch/navigation_launch.py">
          <arg name="use_sim_time" value="false"/>
          <arg name="params_file" value="$(var params_file)"/>
          <arg name="autostart" value="$(var autostart)"/>
          <arg name="use_respawn" value="$(var use_respawn)"/>
          <arg name="log_level" value="$(var log_level)"/>
          <arg name="map_topic" value="$(var map_topic)"/>
          <arg name="scan_topic_front" value="$(var scan_topic_filtered_front)"/>
          <arg name="scan_topic_rear" value="$(var scan_topic_filtered_rear)"/>
          <arg name="scan_topic_amcl" value="$(var scan_topic_merged)"/>
          <arg name="map_yaml" value="$(var map_yaml)"/>
          <arg name="base_frame_id" value="$(var base_frame_id)"/>
          <arg name="odom_frame_id" value="$(var odom_frame_id)"/>
          <arg name="map_frame_id" value="$(var map_frame_id)"/>
          <arg name="update_min_d" value="$(var update_min_d)"/>
          <arg name="update_min_a" value="$(var update_min_a)"/>
          <arg name="laser_max_range" value="$(var laser_max_range)"/>
          <arg name="beam_skip_distance" value="$(var beam_skip_distance)"/>
          <arg name="beam_skip_error_threshold" value="$(var beam_skip_error_threshold)"/>
          <arg name="beam_skip_threshold" value="$(var beam_skip_threshold)"/>
          <arg name="do_beamskip" value="$(var do_beamskip)"/>
          <arg name="controller_frequency" value="$(var controller_frequency)"/>
          <arg name="path_align_forward_point_distance" value="$(var path_align_forward_point_distance)"/>
          <arg name="goal_align_forward_point_distance" value="$(var goal_align_forward_point_distance)"/>
          <arg name="inflation_radius" value="$(var inflation_radius)"/>
          <arg name="path_align_scale" value="$(var path_align_scale)"/>
          <arg name="goal_align_scale" value="$(var goal_align_scale)"/>
          <arg name="path_dist_scale" value="$(var path_dist_scale)"/>
          <arg name="goal_dist_scale" value="$(var goal_dist_scale)"/>
          <arg name="cost_scaling_factor" value="$(var cost_scaling_factor)"/>
          <arg name="base_obstacle_scale" value="$(var base_obstacle_scale)"/>
          <arg name="controller_plugin_type" value="$(var controller_plugin_type)"/>
          <arg name="expected_planner_frequency" value="$(var expected_planner_frequency)"/>
          <arg name="planner_plugin_type" value="$(var planner_plugin_type)"/>
          <arg name="robot_radius" value="$(var robot_radius)"/>
          <arg name="mppi_wide_ cost_critic_cost_weight" value="$(var mppi_wide_cost_critic_cost_weight)"/>
          <arg name="mppi_narrow_cost_critic_cost_weight" value="$(var mppi_narrow_cost_critic_cost_weight)"/>
          <arg name="mppi_wide_path_align_critic_cost_weight" value="$(var mppi_wide_path_align_critic_cost_weight)"/>
          <arg name="mppi_narrow_path_align_critic_cost_weight" value="$(var mppi_narrow_path_align_critic_cost_weight)"/>
          <arg name="mppi_obstacles_critic_repulsion_weight" value="$(var mppi_obstacles_critic_repulsion_weight)"/>
          <arg name="mppi_obstacles_critic_critical_weight" value="$(var mppi_obstacles_critic_critical_weight)"/>
          <arg name="mppi_obstacles_critic_collision_margin_distance" value="$(var mppi_obstacles_critic_collision_margin_distance)"/>
          <arg name="mppi_wide_wz_std" value="$(var mppi_wide_wz_std)"/>
          <arg name="mppi_narrow_wz_std" value="$(var mppi_narrow_wz_std)"/>
          <arg name="velocity_smoother_feedback_type" value="$(var velocity_smoother_feedback_type)"/>
          <arg name="dock_pose_stl_model_path" value="$(var dock_pose_stl_model_path)"/>
          <arg name="use_battery_state_simulation" value="$(var use_battery_state_simulation)"/>
          <arg name="publish_dock_point_cloud" value="$(var publish_dock_point_cloud)"/>
          <arg name="docking_bt_selection" value="$(var docking_bt_selection)"/>
          <arg name="force_centroid_guess" value="$(var force_centroid_guess)"/>
          <arg name="use_statistical_outlier_removal_and_downsampling" value="$(var use_statistical_outlier_removal_and_downsampling)"/>
          <arg name="mppi_cost_critic_cost_weight" value="$(var mppi_cost_critic_cost_weight)"/>
          <arg name="mppi_path_align_critic_cost_weight" value="$(var mppi_path_align_critic_cost_weight)"/>
          <arg name="mppi_time_steps" value="$(var mppi_time_steps)"/>
          <arg name="mppi_batch_size" value="$(var mppi_batch_size)"/>
          <arg name="mppi_vx_std" value="$(var mppi_vx_std)"/>
          <arg name="mppi_wz_std" value="$(var mppi_wz_std)"/>
          <arg name="mppi_vx_max" value="$(var mppi_vx_max)"/>
