<!--
  * Main changes from ROS1 to ROS2:
  *  - 'arg' tags in substitutions are replaced with 'var' tags (not in declarations).
-->

<launch>
    <arg name="odom_frame_id" default="odometry" description="Frame id for the odometry"/>
    <arg name="base_frame_id" default="base_footprint" description="Frame id for the base footprint"/>
    <arg name="linear_odom_scale" default="1.6" description="Scale factor for linear odometry"/>
    <arg name="angular_odom_scale" default="1.8" description="Scale factor for angular odometry"/>
    <arg name="linear_vel_scale" default="false" description="Apply scale factor for linear velocity commands"/>
    <arg name="angular_vel_scale" default="false" description="Apply scale factor for angular velocity commands"/>
    <arg name="log_level_segway" default="info" description="Log level for segway_rmp_ros2"/>

    <node pkg="segway_rmp_ros2"
          exec="segway_rmp_node_ros2"
          name="segway_rmp_node_ros2"
          output="screen"
          on_exit="shutdown">

          <!-- Parameters -->
          <param name="interface_type" value="serial" />
          <param name="serial_port" value="/dev/segway_rmp" />
          <param name="frame_id" value="$(var base_frame_id)" />
          <param name="invert_linear_vel_cmds" value="false" />
          <param name="invert_angular_vel_cmds" value="false" />
          <param name="broadcast_tf" value="true" />
          <param name="rmp_type" value="50/100" />
          <!-- param name="linear_pos_accel_limit" value="1.0" /> -->
          <!-- param name="linear_neg_accel_limit" value="1.0" /> -->
          <!-- param name="angular_pos_accel_limit" value="45.0" /> -->
          <!-- param name="angular_neg_accel_limit" value="45.0" /> -->
          <!-- param name="max_linear_vel" value="0.75" /> -->
          <!-- param name="max_angular_vel" value="0.5" /> -->
          <param name="odom_frame_id" value="$(var odom_frame_id)" />
          <param name="linear_odom_scale" value="$(var linear_odom_scale)" />
          <param name="angular_odom_scale" value="$(var angular_odom_scale)" />
          <param name="linear_vel_scale" value="$(var linear_vel_scale)" />
          <param name="angular_vel_scale" value="$(var angular_vel_scale)" />
          <param name="log_level" value="$(var log_level_segway)" />
    </node>
</launch>
