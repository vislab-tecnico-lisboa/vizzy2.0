<!--
  This Behavior Tree is designed to perform a semi-complete docking mission using Nav2's Docking Server.

  It consists of the following steps:
    1. Activate the dock_pose_estimator_node to start estimating the dock's pose using laser scan data.
    2. Execute the docking maneuver using the DockRobot action, which utilizes the estimated dock pose.
    3. Deactivate the dock_pose_estimator_node after the docking maneuver is complete to conserve resources.    
    The BT ensures that the dock_pose_estimator_node is only active during the docking procedure, optimizing resource usage.

  In this BT there is no navigation to a staging pose before docking. It is assumed that the robot is already in a suitable
  position to begin the docking procedure.

  * The main objective of this BT is to ensure a seamless and efficient docking procedure by using as few
  * resources as possible.
-->
<root main_tree_to_execute="DockingMission" BTCPP_format="4">
  <BehaviorTree ID="DockingMission">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <Sequence name="CompleteProcedure">
        <Sequence name="DockingBackwards">

          <!-- Configure the dock pose estimator node. -->
          <ManageLifecycleNodes transition="configure" node="{node}"/> 
        
          <!-- Activate the dock pose estimator node only in the staging pose. This will save unecessary resources. -->
          <ManageLifecycleNodes transition="activate" node="{node}"/>

          <!-- Wait for 5 seconds to allow the dock pose estimator to start publishing the dock pose. -->
          <Wait wait_duration="5"/>

          <!-- Once in the staging pose and the dock pose estimator is active, we can dock the robot. -->
          <DockRobot dock_id="dock_1" navigate_to_staging_pose="false"/>

          <!-- Deactivate the dock pose estimator node after the docking is complete. -->
          <ManageLifecycleNodes transition="deactivate" node="{node}"/>

          <!-- Cleanup the dock pose estimator node so it goes back to the 'unconfigured' stage. -->
          <ManageLifecycleNodes transition="cleanup" node="{node}"/>
          
        </Sequence>
      </Sequence>

      <!-- Fallback behaviour. -->
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Wait wait_duration="5"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>