<!--
  This Behavior Tree is designed to perform a complete docking mission using Nav2's Docking Server.

  It consists of the following steps:
    1. Navigate to a predefined staging pose near the docking station using the NavigateToPose action.
    2. Activate the dock_pose_estimator_node to start estimating the dock's pose using laser scan data.
    3. Execute the docking maneuver using the DockRobot action, which utilizes the estimated dock pose.
    4. Deactivate the dock_pose_estimator_node after the docking maneuver is complete to conserve resources.    
    The BT ensures that the dock_pose_estimator_node is only active during the docking procedure, optimizing resource usage.

  The automatic navigation to the staging pose handled by the docking server is not used due to the need
  for the integration of the dock_pose_estimator_node activation and deactivation within the docking process.

  * The main objective of this BT is to ensure a seamless and efficient docking procedure by using as few
  * resources as possible.
-->
<root main_tree_to_execute="DockingMission">
  <BehaviorTree ID="DockingMission">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="DockingSequence">
        <SetBlackboard output_key="selected_controller" value="mppi_controller_wide" />   
        <RateController hz="GLOBAL_PLANNER_FREQUENCY">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <Sequence name="ComputeAndSmoothPath">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="PLANNER_PLACEHOLDER"/>
              <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}"/>
            </Sequence>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">

          <!-- The Parallel node is responsible for the dynamic change of the controller
               It does this by concurrently following the path and checking its cost.
               Because of the concurrent nature of the Parallel node, it must be controlled
               very carefully to ensure it does not return FAILURE or SUCCESS prematurely.

               The Parallel node has 2 children:
                1. GoalReached: This node checks if the goal has been reached.
                2. FollowPath: This node will follow the path using the selected controller.
                3. Repeat: This node will continuously check the path cost and select the appropriate controller.

               The success_threshold is set to 1, meaning that if the FollowPath node or the GoalReached node succeed, 
               the Parallel node will succeed.
               The Repeat node will run indefinitely until the goal is reached, so it will never return anything.

               The failure_threshold is set to 2, meaning that FAILURE is only returned if the goal is not reached 
               (GoalReached node fails) and the FollowPath node fails as well.

               This is explained as well in the default custom_docking_bt_plugin.xml file in this package.
               The difference in with this implementation is that it is only used during the docking procedure,
               (overriding the default one used by the bt_navigator in the event of a docking mission).
           -->

          <Parallel success_threshold="1" failure_threshold="2">
            <GoalReached goal="{goal}" />
            <FollowPath path="{path}" controller_id="{selected_controller}"/>
            <Repeat num_cycles="-1">
              <Sequence>
                <IfThenElse name="CheckAndSelectController">
                  <CheckPathCost
                      path="{path}"
                      tf_buffer="{tf_buffer}"
                      global_frame="{global_frame}"
                      robot_base_frame="{robot_base_frame}"
                      check_distance="1.0"
                      cost_threshold="30"
                      ratio_threshold="0.25" />
                  <SetBlackboard output_key="selected_controller" value="mppi_controller_narrow" />
                  <SetBlackboard output_key="selected_controller" value="mppi_controller_wide" />
                </IfThenElse>
                <Wait wait_duration="1.0" />
              </Sequence>
            </Repeat>
          </Parallel>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>

        <!-- Activate the dock pose estimator node only in the staging pose. This will save unecessary resources. -->
        <ManageLifecycleNodes transition="activate" node="{node}"/>

        <!-- Once in the staging pose and the dock pose estimator is active, we can dock the robot. -->
        <DockRobot dock_id="dock_1" navigate_to_staging_pose="false"/>

        <!-- Deactivate the dock pose estimator node after docking is complete. -->
        <ManageLifecycleNodes transition="deactivate" node="{node}"/>

      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>