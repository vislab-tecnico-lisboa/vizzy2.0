<!--
  This Behavior Tree replans the global path periodically at GLOBAL_PLANNER_FREQUENCY Hz and it also has
  recovery actions specific to planning / control as well as general system issues.
  This will be continuous if a kinematically valid planner is selected.

  * There are placeholders for the following parameters:
    - PLANNER_PLACEHOLDER: The ID of the global planner to use.
    - GLOBAL_PLANNER_FREQUENCY: The frequency at which the global planner will be called.
  
  These placeholders will be replaced with the actual values when the navigation launch is executed.

  * The main objective of this BT is to ensure simple navigation with periodic replanning and recovery behaviors.
-->
<root main_tree_to_execute="MainTree" BTCPP_format="4">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <SetBlackboard output_key="selected_controller" value="CONTROLLER_PLACEHOLDER" />   
        <RateController hz="GLOBAL_PLANNER_FREQUENCY">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <Sequence name="ComputeAndSmoothPath">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="PLANNER_PLACEHOLDER"/>
              <ForceSuccess>
                <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" smoother_id="SmoothPath"/>
              </ForceSuccess>
            </Sequence>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="CONTROLLER_PLACEHOLDER" goal_checker_id="general_goal_checker" progress_checker_id="progress_checker"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Wait wait_duration="5"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>