<!--
  This Behavior Tree replans the global path periodically at GLOBAL_PLANNER_FREQUENCY Hz and it also has
  recovery actions specific to planning / control as well as general system issues.
  This will be continuous if a kinematically valid planner is selected.

  * There are placeholders for the following parameters:
    - PLANNER_PLACEHOLDER: The ID of the global planner to use.
    - GLOBAL_PLANNER_FREQUENCY: The frequency at which the global planner will be called.
  
  These placeholders will be replaced with the actual values when the navigation launch is executed.

  * The main objective of this BT is to ensure simple navigation with periodic replanning and recovery behaviors.
-->
<root main_tree_to_execute="MainTree" BTCPP_format="4">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <SetBlackboard output_key="selected_controller" value="CONTROLLER_PLACEHOLDER" />   
        <RateController hz="GLOBAL_PLANNER_FREQUENCY">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <Sequence name="ComputeAndSmoothPath">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="PLANNER_PLACEHOLDER" error_code_id="{compute_path_error_code}"/>
              <ForceSuccess>
                <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" smoother_id="SmoothPath"/>
              </ForceSuccess>
            </Sequence>
            <!-- On a planner error a clear could fix, wipe the ENTIRE global costmap:
                 stale far-away obstacle marks (beyond the robot window) can make the
                 goal/path unplannable, and a clear-around would not reach them. -->
            <Sequence name="PlannerRecovery">
              <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="CONTROLLER_PLACEHOLDER" goal_checker_id="general_goal_checker" progress_checker_id="progress_checker" error_code_id="{follow_path_error_code}"/>
          <Sequence name="ControllerRecovery">
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <ClearCostmapAroundRobot name="ClearLocalCostmap-Context" service_name="local_costmap/clear_around_local_costmap"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearCostmapAroundRobot name="ClearLocalCostmap-Subtree"  service_name="local_costmap/clear_around_local_costmap"/>
            <ClearEntireCostmap      name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <!-- Escape an inflated/lethal start zone (e.g. NO_VALID_PATH after getting too close)
               and re-orient to help re-localize. BackUp and Spin are collision-checked against
               the local costmap (front+rear lasers): they move only if there is room and abort
               safely otherwise, so the RoundRobin falls through to Wait. -->
          <BackUp backup_dist="0.30" backup_speed="0.10" time_allowance="10"/>
          <Spin spin_dist="1.57" time_allowance="10"/>
          <!-- Localization recovery: full AMCL global re-localization, then a sweep of partial
               spins interleaved with short, collision-checked forward drives so AMCL gets
               the motion it needs to re-converge from the global particle spread. Each
               motion is wrapped in ForceSuccess so a blocked drive/spin does not abort the
               sweep. Repeat runs the sweep step 5 times (matching the old node). -->
          <Sequence name="RelocalizationRecovery">
            <ReinitializeGlobalLocalization service_name="reinitialize_global_localization"/>
            <Repeat num_cycles="5">
              <Sequence name="RelocalizeSweepStep">
                <ForceSuccess>
                  <Spin spin_dist="0.785" time_allowance="10"/>
                </ForceSuccess>
                <ForceSuccess>
                  <DriveOnHeading dist_to_travel="0.5" speed="0.15" time_allowance="10"/>
                </ForceSuccess>
              </Sequence>
            </Repeat>
          </Sequence>
          <Wait wait_duration="10"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>