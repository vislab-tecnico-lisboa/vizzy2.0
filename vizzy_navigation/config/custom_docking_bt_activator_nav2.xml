<!--
  This Behavior Tree is designed to activate the dock_pose_estimator_node independently.

  The automatic navigation to the staging pose handled by the docking server is not used due to the need
  for the integration of the dock_pose_estimator_node activation and deactivation within the docking process.

  * The main objective of this BT is to activate the dock pose estimator node independently for testing purposes.
-->
<root main_tree_to_execute="DockPoseDetectionActivator">
  <BehaviorTree ID="DockPoseDetectionActivator">
    <!-- Activate the dock pose estimator node. -->
    <ManageLifecycleNodes transition="activate" node="dock_pose_estimator_node"/>
  </BehaviorTree>
</root>