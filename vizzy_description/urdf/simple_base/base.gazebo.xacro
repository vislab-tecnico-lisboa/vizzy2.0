<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="base_frame_id" default="base_footprint"/>

  <xacro:macro name="base_gazebo">

    <gazebo reference="base_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
    </gazebo>

    <gazebo reference="$(arg base_frame_id)">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
    </gazebo>

    <gazebo reference="waist_link">
      <mu1>10000</mu1>
      <mu2>10000</mu2>
    </gazebo>
  </xacro:macro>
</robot>
